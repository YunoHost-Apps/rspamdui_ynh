#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# RETRIEVE ARGUMENTS FROM THE MANIFEST
#=================================================

ynh_app_setting_set --key=password --value=$password

#=================================================
# NGINX CONFIGURATION
#=================================================
ynh_script_progression "Configuring NGINX web server..."

ynh_config_add_nginx

#=================================================
# CONFIGURE RSPAMD
#=================================================
ynh_script_progression "Configuring RSPAMD..."

encrypted_password=$(rspamadm pw -p $password)

# Set the password through local.d rather than editing worker-controller.inc, which is a
# conffile owned by the rspamd package: modifying it makes every later rspamd upgrade that
# ships a new version of that file stall on an unanswerable dpkg prompt.
# local.d is included at priority=1 and merges into the section, so this overrides the
# stock password while leaving count/secure_ip/static_dir intact.
echo "password = \"$encrypted_password\";" > /etc/rspamd/local.d/worker-controller.inc

ynh_systemctl --service=rspamd --action="restart"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
